# Application Configuration
# Available options: mock, bedrock
LLM_PROVIDER=mock

# AWS Bedrock Configuration (required if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# DO NOT HARDCODE AWS CREDENTIALS IN CODE OR ENV FILES IN PRODUCTION
# Provide them securely via IAM Roles, standard AWS credential file, or env vars during runtime
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Backend Configuration
PORT=8000
